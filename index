<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciación a las derivadas · 1º Bachillerato General</title>
  <meta name="description" content="Web interactiva para iniciar las derivadas en Matemáticas Generales de 1º de Bachillerato General." />
  <style>
    :root{
      --azul:#28348A;
      --azul-2:#1F2F46;
      --turquesa:#20D9C3;
      --turquesa-2:#0FBCA8;
      --fondo:#F4F7FF;
      --blanco:#ffffff;
      --gris:#5f6681;
      --borde:#D9E2FF;
      --sombra:0 18px 44px rgba(31,47,70,.14);
      --radio:24px;
      --ok:#168c64;
      --mal:#c0392b;
      --naranja:#F2B84B;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top left, rgba(32,217,195,.20), transparent 28rem),
        radial-gradient(circle at 90% 10%, rgba(40,52,138,.13), transparent 24rem),
        linear-gradient(180deg, #fff 0%, var(--fondo) 42%, #fff 100%);
      color:var(--azul-2);
      line-height:1.55;
    }
    a{color:var(--azul)}
    .wrap{width:min(1160px, calc(100% - 32px)); margin:0 auto}
    header.hero{
      position:relative;
      overflow:hidden;
      padding:28px 0 18px;
      border-bottom:1px solid var(--borde);
      background:rgba(255,255,255,.78);
      backdrop-filter: blur(8px);
    }
    .hero-grid{display:grid; grid-template-columns:140px 1fr; gap:24px; align-items:center}
    .logo-box{background:#fff; border:4px solid var(--azul); border-radius:28px; padding:10px; box-shadow:var(--sombra)}
    .logo-box img{display:block; width:100%; height:auto}
    .eyebrow{font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--turquesa-2); font-size:.86rem}
    h1{margin:.1rem 0 .4rem; font-size:clamp(2rem, 5vw, 4.6rem); line-height:1; color:var(--azul); letter-spacing:-.06em}
    .subtitle{font-size:clamp(1.05rem, 2vw, 1.45rem); max-width:880px; color:var(--azul-2); margin:0 0 1rem}
    .chips{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px}
    .chip{display:inline-flex; align-items:center; gap:8px; border:1px solid var(--borde); border-radius:999px; padding:8px 12px; background:#fff; font-weight:750; color:var(--azul)}
    .chip strong{color:var(--azul-2)}
    nav{
      position:sticky; top:0; z-index:20;
      background:rgba(255,255,255,.92);
      border-bottom:1px solid var(--borde);
      backdrop-filter:blur(12px);
    }
    nav .wrap{display:flex; gap:8px; overflow:auto; padding:10px 0}
    nav a{white-space:nowrap; text-decoration:none; color:var(--azul); font-weight:800; border:1px solid transparent; padding:9px 12px; border-radius:999px}
    nav a:hover, nav a:focus{background:var(--azul); color:#fff}
    main{padding:28px 0 80px}
    section{scroll-margin-top:76px; margin:26px 0}
    .card{
      background:rgba(255,255,255,.94);
      border:1px solid var(--borde);
      border-radius:var(--radio);
      box-shadow:var(--sombra);
      padding:clamp(18px, 3vw, 30px);
    }
    .section-head{display:flex; align-items:flex-start; gap:16px; margin-bottom:18px}
    .num{flex:0 0 auto; width:42px; height:42px; display:grid; place-items:center; border-radius:14px; background:var(--azul); color:#fff; font-weight:900; box-shadow:0 8px 18px rgba(40,52,138,.22)}
    h2{font-size:clamp(1.5rem, 3vw, 2.4rem); line-height:1.08; margin:0; color:var(--azul)}
    h3{color:var(--azul); margin:1.25rem 0 .55rem; font-size:1.25rem}
    .lead{font-size:1.08rem; margin:.4rem 0 0; color:var(--gris)}
    .grid-2{display:grid; grid-template-columns:1fr 1fr; gap:18px}
    .grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
    .mini{border:1px solid var(--borde); border-radius:20px; padding:18px; background:linear-gradient(180deg,#fff,#f9fbff)}
    .mini h3{margin-top:0}
    .formula{
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      background:#F1F4FF;
      color:var(--azul);
      border-left:6px solid var(--turquesa);
      padding:14px 16px;
      border-radius:14px;
      overflow:auto;
      font-weight:750;
    }
    .note{border:1px dashed var(--turquesa-2); background:rgba(32,217,195,.10); border-radius:18px; padding:14px 16px; margin:14px 0}
    .warning{border:1px solid rgba(242,184,75,.65); background:rgba(242,184,75,.13); border-radius:18px; padding:14px 16px; margin:14px 0}
    label{font-weight:800; display:block; margin:12px 0 6px; color:var(--azul)}
    input, select, button, textarea{
      font:inherit;
    }
    input, select, textarea{
      width:100%; border:1px solid var(--borde); border-radius:14px; padding:12px 14px; background:#fff; color:var(--azul-2); outline:none;
    }
    input:focus, select:focus, textarea:focus{border-color:var(--turquesa-2); box-shadow:0 0 0 4px rgba(32,217,195,.16)}
    .row{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    .btns{display:flex; flex-wrap:wrap; gap:10px; margin-top:14px}
    button, .button-like{
      border:0; border-radius:999px; padding:11px 16px; background:var(--azul); color:#fff; font-weight:900; cursor:pointer; box-shadow:0 8px 18px rgba(40,52,138,.18); text-decoration:none; display:inline-flex; align-items:center; gap:8px;
    }
    button:hover{transform:translateY(-1px)}
    button.secondary{background:#fff; color:var(--azul); border:1px solid var(--borde); box-shadow:none}
    button.turq{background:var(--turquesa-2)}
    button.warn{background:var(--naranja); color:#222}
    .result{margin-top:14px; border-radius:18px; padding:16px; background:#F7F9FF; border:1px solid var(--borde); min-height:72px}
    .result strong{color:var(--azul)}
    .big-number{font-size:2rem; color:var(--azul); font-weight:950; letter-spacing:-.04em}
    .ok{color:var(--ok); font-weight:900}
    .bad{color:var(--mal); font-weight:900}
    .canvas-card{background:#fff; border:1px solid var(--borde); border-radius:20px; padding:10px; overflow:hidden}
    svg{max-width:100%; height:auto; display:block}
    .rules{display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:14px}
    .rule-card{background:#fff; border:1px solid var(--borde); border-radius:18px; padding:16px}
    .rule-card strong{display:block; color:var(--azul); font-size:1.08rem; margin-bottom:6px}
    .pill{display:inline-block; margin-top:8px; padding:5px 9px; border-radius:999px; background:rgba(32,217,195,.14); color:var(--azul); font-weight:850; font-size:.9rem}
    .exercise-box{display:grid; grid-template-columns:1.1fr .9fr; gap:18px; align-items:start}
    .choices{display:grid; gap:10px; margin-top:12px}
    .choice{border:1px solid var(--borde); background:#fff; color:var(--azul-2); box-shadow:none; border-radius:16px; padding:12px 14px; text-align:left; justify-content:flex-start}
    .choice.correct{border-color:rgba(22,140,100,.55); background:rgba(22,140,100,.09)}
    .choice.incorrect{border-color:rgba(192,57,43,.55); background:rgba(192,57,43,.09)}
    .progress{height:12px; border-radius:999px; background:#E8EDFF; overflow:hidden; margin:10px 0 4px}
    .bar{height:100%; width:0%; background:linear-gradient(90deg,var(--turquesa),var(--azul)); transition:.35s ease}
    details{border:1px solid var(--borde); border-radius:18px; padding:14px 16px; background:#fff; margin:12px 0}
    summary{font-weight:900; color:var(--azul); cursor:pointer}
    .two-col-list{columns:2; column-gap:32px}
    .print-sheet{background:#fff; border:1px solid var(--borde); border-radius:20px; padding:18px; margin-top:16px}
    .print-sheet ol{margin-top:8px}
    footer{padding:26px 0 46px; color:var(--gris); text-align:center; border-top:1px solid var(--borde); background:#fff}
    .tiny{font-size:.92rem; color:var(--gris)}
    .kbd{font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; border:1px solid var(--borde); border-bottom-width:3px; padding:1px 6px; border-radius:6px; background:#fff; color:var(--azul)}
    @media (max-width: 860px){
      .hero-grid, .grid-2, .grid-3, .exercise-box{grid-template-columns:1fr}
      .logo-box{width:132px}
      .rules{grid-template-columns:1fr}
      .two-col-list{columns:1}
      .row{grid-template-columns:1fr}
    }
    @media print{
      nav, .btns, .canvas-card, header.hero .logo-box, button{display:none!important}
      body{background:#fff; color:#111}
      .card{box-shadow:none; border:1px solid #bbb; page-break-inside:avoid}
      section{margin:14px 0}
      .wrap{width:100%; margin:0}
    }
  </style>
</head>
<body>
  <header class="hero">
    <div class="wrap hero-grid">
      <div class="logo-box" aria-label="Logo del proyecto CITE-STEAM IA, FP y robótica inclusiva">
        <img src="data:image/png;base64," alt="IA-FP Robótica inclusiva. Proyecto CITE-STEAM IES San José Badajoz" />
      </div>
      <div>
        <div class="eyebrow">Matemáticas Generales · 1º Bachillerato General</div>
        <h1>Iniciación a las derivadas</h1>
        <p class="subtitle">Una secuencia interactiva para pasar de la <strong>tasa de variación media</strong> a las primeras <strong>reglas de derivación</strong>, sin trigonometría y con ejemplos sencillos.</p>
        <div class="chips" aria-label="Datos de la secuencia">
          <span class="chip">👩‍🏫 Profesora: <strong>Cristina Ramos García</strong></span>
          <span class="chip">🏫 IES San José Badajoz</span>
          <span class="chip">🤖 CITE-STEAM · IA, FP y robótica inclusiva</span>
        </div>
      </div>
    </div>
  </header>

  <nav aria-label="Navegación por la web">
    <div class="wrap">
      <a href="#inicio">Inicio</a>
      <a href="#tvm">1. TVM</a>
      <a href="#limite">2. Derivada con límite</a>
      <a href="#reglas">3. Reglas</a>
      <a href="#practica">4. Práctica guiada</a>
      <a href="#quiz">5. Quiz</a>
      <a href="#docente">Guía docente</a>
    </div>
  </nav>

  <main class="wrap">
    <section id="inicio" class="card">
      <div class="section-head">
        <div class="num">0</div>
        <div>
          <h2>¿Qué vamos a aprender?</h2>
          <p class="lead">La idea clave: una derivada mide cómo cambia una función, primero entre dos puntos y después “en un punto”.</p>
        </div>
      </div>
      <div class="grid-3">
        <div class="mini">
          <h3>1. Cambio medio</h3>
          <p>Calculamos cuánto cambia una función entre dos valores de <span class="kbd">x</span>. Es la pendiente de la recta secante.</p>
          <div class="formula">TVM[a,b] = (f(b) - f(a)) / (b - a)</div>
        </div>
        <div class="mini">
          <h3>2. Cambio instantáneo</h3>
          <p>Acercamos los dos puntos cada vez más. Ahí aparece la derivada en un punto.</p>
          <div class="formula">f'(a) = lim h→0 [f(a+h) - f(a)] / h</div>
        </div>
        <div class="mini">
          <h3>3. Reglas rápidas</h3>
          <p>Después dejamos los límites y trabajamos con reglas: suma, producto, cociente, potencia y cadena.</p>
          <div class="formula">Si f(x)=xⁿ, entonces f'(x)=n·xⁿ⁻¹</div>
        </div>
      </div>
      <div class="warning">
        <strong>Importante:</strong> en esta web no aparecen seno, coseno ni tangente. Falta un bloque importante de funciones trigonométricas, pero lo dejamos fuera porque todavía no se ha trabajado en este grupo.
      </div>
    </section>

    <section id="tvm" class="card">
      <div class="section-head">
        <div class="num">1</div>
        <div>
          <h2>Tasa de variación media</h2>
          <p class="lead">Sirve para medir el cambio de una función en un intervalo. En la gráfica es la pendiente de la recta que une dos puntos.</p>
        </div>
      </div>
      <div class="grid-2">
        <div>
          <h3>Calculadora de TVM</h3>
          <label for="funcTvm">Elige una función sencilla</label>
          <select id="funcTvm">
            <option value="x2minus1">f(x)=x² − 1</option>
            <option value="x2">f(x)=x²</option>
            <option value="lineal">f(x)=2x + 1</option>
            <option value="constante">f(x)=3</option>
            <option value="cubica">f(x)=x³</option>
          </select>
          <div class="row">
            <div>
              <label for="aTvm">Extremo izquierdo a</label>
              <input id="aTvm" type="number" step="0.1" value="-1" />
            </div>
            <div>
              <label for="bTvm">Extremo derecho b</label>
              <input id="bTvm" type="number" step="0.1" value="0" />
            </div>
          </div>
          <div class="btns">
            <button type="button" onclick="calcularTVM()">Calcular TVM</button>
            <button class="secondary" type="button" onclick="ejemploTVM(-1,0)">Ejemplo [-1, 0]</button>
            <button class="secondary" type="button" onclick="ejemploTVM(1,2)">Ejemplo [1, 2]</button>
          </div>
          <div id="resTvm" class="result" aria-live="polite"></div>
        </div>
        <div class="canvas-card">
          <svg id="svgTvm" viewBox="0 0 640 420" role="img" aria-label="Gráfica de la función y recta secante"></svg>
        </div>
      </div>
      <details>
        <summary>Ejemplo completo: f(x)=x² − 1 en [-1,0] y [1,2]</summary>
        <div class="grid-2">
          <div>
            <h3>Intervalo [-1,0]</h3>
            <p>f(-1)=(-1)²−1=0 y f(0)=0²−1=-1.</p>
            <div class="formula">TVM[-1,0] = (-1 - 0) / (0 - (-1)) = -1</div>
            <p>La función baja una unidad cuando x avanza una unidad.</p>
          </div>
          <div>
            <h3>Intervalo [1,2]</h3>
            <p>f(1)=1²−1=0 y f(2)=2²−1=3.</p>
            <div class="formula">TVM[1,2] = (3 - 0) / (2 - 1) = 3</div>
            <p>La función sube tres unidades cuando x avanza una unidad.</p>
          </div>
        </div>
      </details>
    </section>

    <section id="limite" class="card">
      <div class="section-head">
        <div class="num">2</div>
        <div>
          <h2>Derivada usando límites: solo las más sencillas</h2>
          <p class="lead">Antes de usar reglas, deducimos unas pocas derivadas básicas. Después dejamos los límites a un lado.</p>
        </div>
      </div>
      <div class="grid-2">
        <div>
          <h3>Explorador de derivada en un punto</h3>
          <label for="funcLim">Función</label>
          <select id="funcLim">
            <option value="c">f(x)=5</option>
            <option value="x">f(x)=x</option>
            <option value="x2">f(x)=x²</option>
            <option value="x2minus1">f(x)=x² − 1</option>
          </select>
          <label for="aLim">Punto a</label>
          <input id="aLim" type="number" step="0.1" value="2" />
          <div class="btns">
            <button type="button" onclick="calcularLimite()">Ver aproximación</button>
            <button class="secondary" type="button" onclick="ponerALim(0)">a=0</button>
            <button class="secondary" type="button" onclick="ponerALim(1)">a=1</button>
            <button class="secondary" type="button" onclick="ponerALim(2)">a=2</button>
          </div>
          <div id="resLim" class="result" aria-live="polite"></div>
        </div>
        <div>
          <h3>Tabla de valores al acercarse h a 0</h3>
          <div id="tablaLim" class="mini"></div>
          <div class="note">
            <strong>Lectura:</strong> cuando h se acerca a 0, el cociente se acerca a un número. Ese número es la pendiente de la tangente en x=a.
          </div>
        </div>
      </div>
      <div class="grid-3">
        <div class="mini">
          <h3>Constante</h3>
          <p>Si una función no cambia, su derivada es 0.</p>
          <div class="formula">f(x)=c → f'(x)=0</div>
        </div>
        <div class="mini">
          <h3>Identidad</h3>
          <p>La función f(x)=x cambia al mismo ritmo que x.</p>
          <div class="formula">f(x)=x → f'(x)=1</div>
        </div>
        <div class="mini">
          <h3>Cuadrática básica</h3>
          <p>Para f(x)=x², la pendiente depende del punto.</p>
          <div class="formula">f(x)=x² → f'(x)=2x</div>
        </div>
      </div>
    </section>

    <section id="reglas" class="card">
      <div class="section-head">
        <div class="num">3</div>
        <div>
          <h2>Reglas de derivación que sí vamos a usar</h2>
          <p class="lead">Una vez entendida la idea, derivar se convierte en aplicar reglas con orden y cuidado.</p>
        </div>
      </div>
      <div class="rules">
        <div class="rule-card"><strong>Constante</strong><div class="formula">(c)' = 0</div><span class="pill">Ejemplo: (7)'=0</span></div>
        <div class="rule-card"><strong>Función x</strong><div class="formula">(x)' = 1</div><span class="pill">Ejemplo: (x)'=1</span></div>
        <div class="rule-card"><strong>Potencia</strong><div class="formula">(xⁿ)' = n·xⁿ⁻¹</div><span class="pill">Ejemplo: (x³)'=3x²</span></div>
        <div class="rule-card"><strong>Número por función</strong><div class="formula">(k·f)' = k·f'</div><span class="pill">Ejemplo: (4x²)'=8x</span></div>
        <div class="rule-card"><strong>Suma o resta</strong><div class="formula">(f ± g)' = f' ± g'</div><span class="pill">Ejemplo: (x²+3x)'=2x+3</span></div>
        <div class="rule-card"><strong>Producto</strong><div class="formula">(f·g)' = f'·g + f·g'</div><span class="pill">Cuidado: no es f'·g'</span></div>
        <div class="rule-card"><strong>Cociente</strong><div class="formula">(f/g)' = (f'·g - f·g') / g²</div><span class="pill">Siempre que g no sea 0</span></div>
        <div class="rule-card"><strong>Regla de la cadena</strong><div class="formula">[g(x)]ⁿ ' = n·[g(x)]ⁿ⁻¹ · g'(x)</div><span class="pill">Ejemplo: [(2x+1)³]'=6(2x+1)²</span></div>
      </div>
      <div class="warning">
        <strong>Funciones pendientes para más adelante:</strong> trigonométricas y otros casos más avanzados. Aquí trabajamos con polinomios, productos, cocientes, potencias compuestas y una pequeña ampliación con exponenciales/logaritmos si la profesora lo decide.
      </div>
    </section>

    <section id="practica" class="card">
      <div class="section-head">
        <div class="num">4</div>
        <div>
          <h2>Práctica guiada: elige la derivada correcta</h2>
          <p class="lead">Pulsa “nuevo ejercicio”, piensa la regla usada y selecciona la respuesta.</p>
        </div>
      </div>
      <div class="exercise-box">
        <div class="mini">
          <h3 id="exTitle">Ejercicio</h3>
          <div id="exFormula" class="formula">Pulsa para empezar.</div>
          <div class="btns">
            <button type="button" onclick="nuevoEjercicio()">Nuevo ejercicio</button>
            <button class="secondary" type="button" onclick="mostrarPista()">Pista</button>
            <button class="secondary" type="button" onclick="mostrarSolucion()">Ver solución</button>
          </div>
          <div id="exFeedback" class="result" aria-live="polite"></div>
        </div>
        <div>
          <h3>Opciones</h3>
          <div id="choices" class="choices"></div>
          <div class="progress"><div id="practiceBar" class="bar"></div></div>
          <p id="practiceScore" class="tiny">Aciertos: 0 · Intentos: 0</p>
        </div>
      </div>
    </section>

    <section id="quiz" class="card">
      <div class="section-head">
        <div class="num">5</div>
        <div>
          <h2>Quiz final de repaso</h2>
          <p class="lead">Diez preguntas cortas para comprobar si la idea básica está clara.</p>
        </div>
      </div>
      <div id="quizBox"></div>
      <div class="btns">
        <button type="button" onclick="corregirQuiz()">Corregir quiz</button>
        <button class="secondary" type="button" onclick="reiniciarQuiz()">Reiniciar</button>
      </div>
      <div id="quizResult" class="result" aria-live="polite"></div>
    </section>

    <section id="docente" class="card">
      <div class="section-head">
        <div class="num">✓</div>
        <div>
          <h2>Guía rápida para usar en clase</h2>
          <p class="lead">Propuesta pensada para una primera aproximación, con contenidos sencillos y práctica inmediata.</p>
        </div>
      </div>
      <div class="grid-2">
        <div>
          <h3>Secuencia sugerida</h3>
          <ol>
            <li>Empezar con TVM en f(x)=x²−1 y comparar los intervalos [-1,0] y [1,2].</li>
            <li>Insistir en la interpretación: pendiente positiva, negativa o cero.</li>
            <li>Ver la derivada por límite solo en funciones constante, x, x² y x²−1.</li>
            <li>Pasar a reglas: potencia, suma/resta, número por función.</li>
            <li>Después producto, cociente y cadena con ejemplos muy controlados.</li>
            <li>Cerrar con el quiz y una ficha impresa breve.</li>
          </ol>
        </div>
        <div>
          <h3>Objetivos de aprendizaje</h3>
          <ul>
            <li>Calcular e interpretar una tasa de variación media.</li>
            <li>Comprender la derivada como pendiente de una tangente.</li>
            <li>Deducir derivadas básicas mediante límites sencillos.</li>
            <li>Aplicar reglas de derivación en funciones sin trigonometría.</li>
            <li>Reconocer cuándo una función crece o decrece a partir del signo de la derivada.</li>
          </ul>
        </div>
      </div>
      <details>
        <summary>Ficha imprimible de refuerzo</summary>
        <div class="print-sheet">
          <h3>Iniciación a las derivadas · Ficha breve</h3>
          <ol>
            <li>Calcula la TVM de f(x)=x²−1 en [-1,0].</li>
            <li>Calcula la TVM de f(x)=x²−1 en [1,2].</li>
            <li>Explica con palabras qué significa que una TVM sea negativa.</li>
            <li>Halla f'(x) si f(x)=7.</li>
            <li>Halla f'(x) si f(x)=x.</li>
            <li>Halla f'(x) si f(x)=x².</li>
            <li>Halla f'(x) si f(x)=3x²−5x+1.</li>
            <li>Halla f'(x) si f(x)=(2x+1)³.</li>
            <li>Halla f'(x) si f(x)=(x+1)(x²−3).</li>
            <li>Indica una función que tenga derivada positiva para x=2.</li>
          </ol>
          <button class="warn" type="button" onclick="window.print()">Imprimir ficha</button>
        </div>
      </details>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <strong>Proyecto CITE-STEAM · IA, FP y robótica inclusiva</strong><br />
      IES San José Badajoz · Matemáticas Generales · 1º Bachillerato General<br />
      <span class="tiny">Material creado para uso educativo. Sin recogida de datos personales.</span>
    </div>
  </footer>

  <script>
    const funcs = {
      x2minus1: {name:'f(x)=x² − 1', f:x=>x*x-1, fp:x=>2*x},
      x2: {name:'f(x)=x²', f:x=>x*x, fp:x=>2*x},
      lineal: {name:'f(x)=2x + 1', f:x=>2*x+1, fp:x=>2},
      constante: {name:'f(x)=3', f:x=>3, fp:x=>0},
      cubica: {name:'f(x)=x³', f:x=>x*x*x, fp:x=>3*x*x},
      c: {name:'f(x)=5', f:x=>5, fp:x=>0},
      x: {name:'f(x)=x', f:x=>x, fp:x=>1}
    };

    function fmt(n){
      if(!isFinite(n)) return 'no definido';
      const rounded = Math.round(n*100000)/100000;
      if(Math.abs(rounded) < 1e-10) return '0';
      return String(rounded).replace('.', ',');
    }
    function fmtDot(n){
      if(!isFinite(n)) return 'no definido';
      const rounded = Math.round(n*100000)/100000;
      if(Math.abs(rounded) < 1e-10) return '0';
      return String(rounded);
    }

    function calcularTVM(){
      const key = document.getElementById('funcTvm').value;
      const a = parseFloat(document.getElementById('aTvm').value);
      const b = parseFloat(document.getElementById('bTvm').value);
      const f = funcs[key].f;
      const res = document.getElementById('resTvm');
      if(!isFinite(a) || !isFinite(b)){
        res.innerHTML = '<span class="bad">Introduce dos números válidos.</span>'; return;
      }
      if(a === b){
        res.innerHTML = '<span class="bad">El intervalo no puede tener extremos iguales: b-a sería 0.</span>'; return;
      }
      const fa = f(a), fb = f(b), tvm = (fb-fa)/(b-a);
      const sentido = tvm>0 ? 'crece en promedio' : tvm<0 ? 'decrece en promedio' : 'no cambia en promedio';
      res.innerHTML = `<p><strong>${funcs[key].name}</strong></p>
        <p>f(${fmt(a)}) = <strong>${fmt(fa)}</strong> · f(${fmt(b)}) = <strong>${fmt(fb)}</strong></p>
        <div class="formula">TVM[${fmt(a)}, ${fmt(b)}] = (${fmt(fb)} - ${fmt(fa)}) / (${fmt(b)} - ${fmt(a)}) = ${fmt(tvm)}</div>
        <p class="big-number">${fmt(tvm)}</p>
        <p>Interpretación: la función <strong>${sentido}</strong> en ese intervalo.</p>`;
      dibujarTVM(key, a, b);
    }

    function ejemploTVM(a,b){
      document.getElementById('funcTvm').value = 'x2minus1';
      document.getElementById('aTvm').value = a;
      document.getElementById('bTvm').value = b;
      calcularTVM();
    }

    function dibujarTVM(key, a, b){
      const svg = document.getElementById('svgTvm');
      const f = funcs[key].f;
      const W=640, H=420, pad=42;
      const xmin = Math.min(-4, a-1, b-1), xmax = Math.max(4, a+1, b+1);
      let ys=[];
      for(let i=0;i<=180;i++){ const x=xmin+(xmax-xmin)*i/180; ys.push(f(x)); }
      ys.push(f(a), f(b));
      let ymin = Math.min(-5, ...ys), ymax = Math.max(5, ...ys);
      if(ymax-ymin < 1){ymax+=1; ymin-=1;}
      const sx=x=>pad+(x-xmin)*(W-2*pad)/(xmax-xmin);
      const sy=y=>H-pad-(y-ymin)*(H-2*pad)/(ymax-ymin);
      let path='';
      for(let i=0;i<=220;i++){
        const x=xmin+(xmax-xmin)*i/220, y=f(x);
        path += (i===0?'M':'L') + sx(x).toFixed(2)+' '+sy(y).toFixed(2)+' ';
      }
      const fa=f(a), fb=f(b);
      const xAxis = (ymin<=0 && ymax>=0) ? `<line x1="${pad}" y1="${sy(0)}" x2="${W-pad}" y2="${sy(0)}" stroke="#AAB4E8" stroke-width="2"/>` : '';
      const yAxis = (xmin<=0 && xmax>=0) ? `<line x1="${sx(0)}" y1="${pad}" x2="${sx(0)}" y2="${H-pad}" stroke="#AAB4E8" stroke-width="2"/>` : '';
      svg.innerHTML = `
        <rect width="${W}" height="${H}" rx="22" fill="#ffffff"/>
        ${xAxis}${yAxis}
        <path d="${path}" fill="none" stroke="#28348A" stroke-width="5" stroke-linecap="round"/>
        <line x1="${sx(a)}" y1="${sy(fa)}" x2="${sx(b)}" y2="${sy(fb)}" stroke="#20D9C3" stroke-width="5" stroke-linecap="round"/>
        <circle cx="${sx(a)}" cy="${sy(fa)}" r="9" fill="#F2B84B" stroke="#28348A" stroke-width="3"/>
        <circle cx="${sx(b)}" cy="${sy(fb)}" r="9" fill="#20D9C3" stroke="#28348A" stroke-width="3"/>
        <text x="${sx(a)+12}" y="${sy(fa)-12}" fill="#28348A" font-weight="800">A(${fmtDot(a)}, ${fmtDot(fa)})</text>
        <text x="${sx(b)+12}" y="${sy(fb)-12}" fill="#28348A" font-weight="800">B(${fmtDot(b)}, ${fmtDot(fb)})</text>
        <text x="24" y="34" fill="#1F2F46" font-weight="900">${funcs[key].name}</text>
        <text x="24" y="394" fill="#5f6681">La recta turquesa es la secante: su pendiente es la TVM.</text>`;
    }

    function calcularLimite(){
      const key = document.getElementById('funcLim').value;
      const a = parseFloat(document.getElementById('aLim').value);
      const res = document.getElementById('resLim');
      if(!isFinite(a)){ res.innerHTML='<span class="bad">Introduce un valor válido para a.</span>'; return; }
      const f = funcs[key].f;
      const deriv = funcs[key].fp(a);
      let deduccion = '';
      if(key==='c') deduccion = 'Como f(a+h) y f(a) valen siempre 5, el numerador es 0. Por eso f\'(a)=0.';
      if(key==='x') deduccion = 'El cociente queda h/h, por eso f\'(a)=1.';
      if(key==='x2') deduccion = 'Al desarrollar (a+h)²−a² queda 2ah+h². Al dividir entre h queda 2a+h, que se acerca a 2a.';
      if(key==='x2minus1') deduccion = 'El −1 se cancela. Se obtiene la misma derivada que en x²: f\'(a)=2a.';
      res.innerHTML = `<p><strong>${funcs[key].name}</strong> en a=${fmt(a)}</p>
        <div class="formula">f'(${fmt(a)}) = lim h→0 [f(${fmt(a)}+h)-f(${fmt(a)})] / h = ${fmt(deriv)}</div>
        <p>${deduccion}</p>`;
      construirTablaLim(key, a);
    }
    function ponerALim(a){ document.getElementById('aLim').value=a; calcularLimite(); }

    function construirTablaLim(key,a){
      const f = funcs[key].f;
      const hs=[1,0.5,0.1,0.01,-0.01,-0.1,-0.5];
      let html='<table style="width:100%; border-collapse:collapse"><thead><tr><th style="text-align:left;border-bottom:1px solid var(--borde);padding:8px">h</th><th style="text-align:left;border-bottom:1px solid var(--borde);padding:8px">[f(a+h)-f(a)]/h</th></tr></thead><tbody>';
      hs.forEach(h=>{
        const q=(f(a+h)-f(a))/h;
        html += `<tr><td style="padding:8px;border-bottom:1px solid var(--borde)">${fmt(h)}</td><td style="padding:8px;border-bottom:1px solid var(--borde)">${fmt(q)}</td></tr>`;
      });
      html+='</tbody></table>';
      document.getElementById('tablaLim').innerHTML=html;
    }

    const ejercicios = [
      {f:'f(x)=7', ans:'f\'(x)=0', rule:'constante', exp:'La derivada de una constante es 0.', choices:['f\'(x)=7','f\'(x)=0','f\'(x)=x','f\'(x)=1']},
      {f:'f(x)=x', ans:'f\'(x)=1', rule:'función identidad', exp:'La derivada de x es 1.', choices:['f\'(x)=x','f\'(x)=0','f\'(x)=1','f\'(x)=2x']},
      {f:'f(x)=x²', ans:'f\'(x)=2x', rule:'potencia', exp:'Bajamos el 2 y restamos 1 al exponente.', choices:['f\'(x)=x','f\'(x)=2x','f\'(x)=x²','f\'(x)=2']},
      {f:'f(x)=3x²−5x+1', ans:'f\'(x)=6x−5', rule:'suma/resta y potencia', exp:'Derivamos término a término: 3x² → 6x, −5x → −5, 1 → 0.', choices:['f\'(x)=3x−5','f\'(x)=6x−5','f\'(x)=6x+1','f\'(x)=x²−5']},
      {f:'f(x)=x⁴−2x²', ans:'f\'(x)=4x³−4x', rule:'potencia y suma/resta', exp:'x⁴ deriva 4x³ y −2x² deriva −4x.', choices:['f\'(x)=4x³−4x','f\'(x)=4x−4','f\'(x)=x³−2x','f\'(x)=4x³−2x']},
      {f:'f(x)=(2x+1)³', ans:'f\'(x)=6(2x+1)²', rule:'cadena', exp:'Derivada exterior: 3(2x+1)². Derivada interior: 2. Multiplicamos.', choices:['f\'(x)=3(2x+1)²','f\'(x)=6(2x+1)²','f\'(x)=(2x+1)²','f\'(x)=6(2x+1)']},
      {f:'f(x)=(x²+1)⁴', ans:'f\'(x)=8x(x²+1)³', rule:'cadena', exp:'Derivada exterior: 4(x²+1)³. Derivada interior: 2x.', choices:['f\'(x)=4(x²+1)³','f\'(x)=8x(x²+1)³','f\'(x)=4x(x²+1)³','f\'(x)=8x(x²+1)⁴']},
      {f:'f(x)=(x+1)(x²−3)', ans:'f\'(x)=(x²−3)+2x(x+1)', rule:'producto', exp:'Producto: f\'g + fg\'. Aquí (x+1)\'=1 y (x²−3)\'=2x.', choices:['f\'(x)=2x','f\'(x)=(x²−3)+2x(x+1)','f\'(x)=2x²−3','f\'(x)=(x+1)+(x²−3)']},
      {f:'f(x)=(x²+1)/(x−2)', ans:'f\'(x)=[2x(x−2)−(x²+1)]/(x−2)²', rule:'cociente', exp:'Cociente: derivada de arriba por abajo menos arriba por derivada de abajo, todo entre abajo al cuadrado.', choices:['f\'(x)=2x/(1)','f\'(x)=[2x(x−2)−(x²+1)]/(x−2)²','f\'(x)=[2x(x−2)+(x²+1)]/(x−2)²','f\'(x)=(2x−1)/(x−2)']},
      {f:'f(x)=4(x−3)⁵', ans:'f\'(x)=20(x−3)⁴', rule:'número por función y cadena', exp:'El 4 se mantiene. (x−3)⁵ deriva 5(x−3)⁴·1.', choices:['f\'(x)=5(x−3)⁴','f\'(x)=20(x−3)⁴','f\'(x)=20(x−3)⁵','f\'(x)=4(x−3)⁴']}
    ];
    let currentExercise = null, practiceOk=0, practiceTotal=0;

    function shuffle(arr){ return [...arr].sort(()=>Math.random()-.5); }
    function nuevoEjercicio(){
      currentExercise = ejercicios[Math.floor(Math.random()*ejercicios.length)];
      document.getElementById('exTitle').textContent = 'Deriva la función';
      document.getElementById('exFormula').textContent = currentExercise.f;
      document.getElementById('exFeedback').innerHTML = 'Elige una opción. Piensa primero qué regla necesitas.';
      const choices = shuffle(currentExercise.choices);
      document.getElementById('choices').innerHTML = choices.map(c=>`<button type="button" class="choice" onclick="responderEjercicio(this)">${c}</button>`).join('');
    }
    function responderEjercicio(btn){
      if(!currentExercise) return;
      const buttons = document.querySelectorAll('#choices .choice');
      buttons.forEach(b=>b.disabled=true);
      practiceTotal++;
      const ok = btn.textContent === currentExercise.ans;
      if(ok){ practiceOk++; btn.classList.add('correct'); }
      else{ btn.classList.add('incorrect'); buttons.forEach(b=>{ if(b.textContent===currentExercise.ans) b.classList.add('correct'); }); }
      document.getElementById('exFeedback').innerHTML = ok ?
        `<span class="ok">Correcto.</span> Regla usada: <strong>${currentExercise.rule}</strong>. ${currentExercise.exp}` :
        `<span class="bad">Revisa.</span> La respuesta correcta es <strong>${currentExercise.ans}</strong>. ${currentExercise.exp}`;
      actualizarPracticeScore();
    }
    function mostrarPista(){
      if(!currentExercise) nuevoEjercicio();
      document.getElementById('exFeedback').innerHTML = `Pista: necesitas la regla de <strong>${currentExercise.rule}</strong>.`;
    }
    function mostrarSolucion(){
      if(!currentExercise) nuevoEjercicio();
      document.getElementById('exFeedback').innerHTML = `<strong>Solución:</strong> ${currentExercise.ans}<br>${currentExercise.exp}`;
      document.querySelectorAll('#choices .choice').forEach(b=>{ if(b.textContent===currentExercise.ans) b.classList.add('correct'); });
    }
    function actualizarPracticeScore(){
      const pct = practiceTotal ? Math.round(100*practiceOk/practiceTotal) : 0;
      document.getElementById('practiceBar').style.width = pct+'%';
      document.getElementById('practiceScore').textContent = `Aciertos: ${practiceOk} · Intentos: ${practiceTotal} · ${pct}%`;
    }

    const quiz = [
      {q:'La TVM de f(x)=x²−1 en [-1,0] es…', a:'−1', opts:['−1','0','1','3']},
      {q:'La TVM de f(x)=x²−1 en [1,2] es…', a:'3', opts:['−1','1','2','3']},
      {q:'Si f(x)=5, entonces f\'(x)=…', a:'0', opts:['0','1','5','x']},
      {q:'Si f(x)=x², entonces f\'(x)=…', a:'2x', opts:['x','2x','x²','2']},
      {q:'La derivada de f(x)=3x²−5x+1 es…', a:'6x−5', opts:['3x−5','6x−5','6x+1','x²−5x']},
      {q:'Si f\'(a)>0, la función en ese punto tiende a…', a:'crecer', opts:['crecer','decrecer','ser constante siempre','no existir']},
      {q:'La regla de la cadena aparece en…', a:'f(x)=(2x+1)³', opts:['f(x)=x²+1','f(x)=7','f(x)=(2x+1)³','f(x)=x']},
      {q:'La derivada de f(x)=(x²+1)⁴ es…', a:'8x(x²+1)³', opts:['4(x²+1)³','8x(x²+1)³','8x(x²+1)⁴','4x²(x²+1)³']},
      {q:'En un producto f·g, la derivada correcta es…', a:'f\'·g + f·g\'', opts:['f\'·g\'','f\'·g + f·g\'','f+g','f\'/g\'']},
      {q:'¿Qué familia de funciones NO se trabaja aquí?', a:'trigonométricas', opts:['polinómicas','trigonométricas','constantes','potencias']}
    ];

    function construirQuiz(){
      const box=document.getElementById('quizBox');
      box.innerHTML = quiz.map((item,i)=>{
        const opts = item.opts.map((op,j)=>`
          <label style="font-weight:650; color:var(--azul-2); margin:8px 0; display:block">
            <input type="radio" name="q${i}" value="${op.replace(/"/g,'&quot;')}" style="width:auto; margin-right:8px"> ${op}
          </label>`).join('');
        return `<div class="mini" style="margin:12px 0"><strong>${i+1}. ${item.q}</strong>${opts}<div id="qfb${i}" class="tiny"></div></div>`;
      }).join('');
    }
    function corregirQuiz(){
      let score=0;
      quiz.forEach((item,i)=>{
        const chosen = document.querySelector(`input[name="q${i}"]:checked`);
        const fb = document.getElementById('qfb'+i);
        if(chosen && chosen.value===item.a){ score++; fb.innerHTML='<span class="ok">Correcto</span>'; }
        else{ fb.innerHTML=`<span class="bad">Respuesta correcta:</span> ${item.a}`; }
      });
      const msg = score>=8 ? 'Muy bien: puedes pasar a ejercicios con más reglas.' : score>=5 ? 'Vas bien, pero conviene repetir los apartados de práctica.' : 'Necesitas repasar TVM y reglas básicas antes de avanzar.';
      document.getElementById('quizResult').innerHTML = `<p class="big-number">${score}/10</p><p>${msg}</p>`;
    }
    function reiniciarQuiz(){ construirQuiz(); document.getElementById('quizResult').innerHTML=''; }

    document.addEventListener('DOMContentLoaded', ()=>{
      calcularTVM();
      calcularLimite();
      nuevoEjercicio();
      construirQuiz();
    });
  </script>
